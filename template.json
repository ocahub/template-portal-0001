      "fields": [
        {
          "key": "logoImage",
          "label": "Logo (imagem)",
          "type": "image",
          "optional": true,
          "help": "Sem imagem, vale o logotipo da loja; sem ele, o nome em texto."
        },
        {
          "key": "logo",
          "label": "Nome da marca",
          "type": "text"
        },
        {
          "key": "cta",
          "label": "Botão do topo",
          "type": "text",
          "optional": true
